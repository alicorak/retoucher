{
  "name": "Annotate for Claude",
  "id": "figma-annotate-claude-dev",
  "api": "1.0.0",
  "editorType": ["figma"],
  "main": "code.js",
  "ui": "ui.html",
  "enablePrivatePluginApi": true,
  "documentAccess": "dynamic-page",
  "permissions": ["teamlibrary"],
  "parameters": [
    { "name": "Note", "key": "note", "description": "What should change? Sent with the selection", "allowFreeform": true }
  ],
  "parameterOnly": false,
  "networkAccess": {
    "allowedDomains": ["none"],
    "devAllowedDomains": ["http://localhost:4747"],
    "reasoning": "Sends notes to a local bridge that Claude Code reads."
  }
}
